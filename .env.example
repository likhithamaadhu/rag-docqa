# Copy to .env and fill in.
DATABASE_URL=postgresql://rag:rag@localhost:5432/rag
REDIS_URL=redis://localhost:6379/0

# Any OpenAI-compatible chat endpoint works. Default: Groq free tier.
#   Groq:   https://api.groq.com/openai/v1   (key from console.groq.com)
#   Gemini: https://generativelanguage.googleapis.com/v1beta/openai/
#   Ollama: http://localhost:11434/v1        (key can be any string)
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=your-key-here
LLM_MODEL=openai/gpt-oss-120b

# Runs locally on CPU, free. Must match VECTOR(384) in db/init.sql.
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

CHUNK_SIZE=800
CHUNK_OVERLAP=150
TOP_K=5
UPLOAD_DIR=./uploads
